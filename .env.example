# Telegram Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Your numeric Telegram User ID (get from @userinfobot or @raw_data_bot)
# Only this User ID will receive alerts and be permitted to click buy buttons / run commands
TELEGRAM_ALLOWED_USER_ID=0

# Helius API Key (Required for Phase 2 holders, dev balance, sniper heuristics)
HELIUS_API_KEY="your_helius_api_key_here"
HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here"

# Execution & Wallet (Required in Phase 3+; keep small burner balance only!)
# Base58 encoded private key of your dedicated Solana burner wallet
SOLANA_PRIVATE_KEY=""
